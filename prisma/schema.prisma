generator client {
  provider = "prisma-client-js"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String          @id @default(cuid())
  email              String          @unique
  passwordHash       String
  role               Role            @default(USER)
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  emailVerified      DateTime?
  verificationToken  String?         @unique
  verificationTokenExpires DateTime?
  barangay           String
  city               String
  dob                DateTime?
  avatarUrl          String?
  firstName          String
  gender             String?
  lastName           String
  middleName         String?
  phone              String
  province           String?
  region             String
  streetAddress      String?
  faultReports       FaultReport[]   @relation("ReportedBy")
  inventoryLogs      InventoryLog[]
  notifications      Notification[]
  searchHistory      SearchHistory[]
  statusLogs         StatusLog[]
  workOrdersCreated  WorkOrder[]      @relation("AssignedBy")
  workOrdersAssigned WorkOrder[]      @relation("AssignedTo")
  maintenanceLogs    MaintenanceLog[]
  technicianApplications TechnicianApplication[] @relation("TechnicianApplications")
  verifiedApplications  TechnicianApplication[] @relation("VerifiedApplications")
  rejectedApplications  TechnicianApplication[] @relation("RejectedApplications")
}

model Pole {
  id           String        @id @default(cuid())
  poleCode     String        @unique
  address      String
  barangay     String
  latitude     Float
  longitude    Float
  status       PoleStatus    @default(ACTIVE)
  installedAt  DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  faultReports FaultReport[]
  statusLogs   StatusLog[]
}

model FaultReport {
  id           String       @id @default(cuid())
  poleId       String
  reportedById String?
  reporterName String?
  reporterEmail String?
  reporterPhone String?
  description  String
  faultType    FaultType
  imageUrls    String[]
  status       ReportStatus @default(OPEN)
  latitude     Float?
  longitude    Float?
  reportedAt   DateTime     @default(now())
  adminNotes   String?
  pole         Pole         @relation(fields: [poleId], references: [id])
  reportedBy   User?        @relation("ReportedBy", fields: [reportedById], references: [id])
  workOrder    WorkOrder?
}

model WorkOrder {
  id              String          @id @default(cuid())
  faultReportId   String          @unique
  assignedToId    String?
  assignedById    String
  status          WorkOrderStatus @default(PENDING)
  assignedAt      DateTime        @default(now())
  resolvedAt      DateTime?
  resolutionNotes String?
  assignedBy      User            @relation("AssignedBy", fields: [assignedById], references: [id])
  assignedTo      User?           @relation("AssignedTo", fields: [assignedToId], references: [id])
  faultReport     FaultReport     @relation(fields: [faultReportId], references: [id])
  maintenanceLogs MaintenanceLog[]
}

model MaintenanceLog {
  id            String    @id @default(cuid())
  workOrderId   String
  technicianId  String
  partsUsed     String?
  timeSpent     Int?
  notes         String?
  imageUrls     String[]
  createdAt     DateTime  @default(now())
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id])
  technician    User      @relation(fields: [technicianId], references: [id])

  @@index([workOrderId])
  @@index([technicianId])
}

model StatusLog {
  id          String     @id @default(cuid())
  poleId      String
  changedById String
  fromStatus  PoleStatus
  toStatus    PoleStatus
  changedAt   DateTime   @default(now())
  reason      String?
  changedBy   User       @relation(fields: [changedById], references: [id])
  pole        Pole       @relation(fields: [poleId], references: [id])
}

model SearchHistory {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String
  lat         Float?
  lng         Float?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  usedAt    DateTime?

  @@index([email, token])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, read, createdAt])
}

model InventoryItem {
  id          String         @id @default(cuid())
  name        String
  description String?
  sku         String         @unique
  quantity    Int            @default(0)
  unit        String         @default("pcs")
  minStock    Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  logs        InventoryLog[]
}

model InventoryLog {
  id        String        @id @default(cuid())
  itemId    String
  userId    String
  change    Int
  note      String?
  createdAt DateTime      @default(now())
  item      InventoryItem @relation(fields: [itemId], references: [id])
  user      User          @relation(fields: [userId], references: [id])

  @@index([itemId, createdAt])
}

enum ApplicationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model TechnicianApplication {
  id            String            @id @default(cuid())
  applicantId   String
  skills        String
  reason        String
  status        ApplicationStatus @default(PENDING)
  verifiedById  String?
  verifiedAt    DateTime?
  rejectedById  String?
  rejectedAt    DateTime?
  rejectedReason String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  applicant     User              @relation("TechnicianApplications", fields: [applicantId], references: [id])
  verifiedBy    User?             @relation("VerifiedApplications", fields: [verifiedById], references: [id])
  rejectedBy    User?             @relation("RejectedApplications", fields: [rejectedById], references: [id])

  @@index([applicantId])
  @@index([status])
}

enum Role {
  SUPERADMIN
  ADMIN
  TECHNICIAN
  USER
  GUEST
}

enum PoleStatus {
  ACTIVE
  FAULTY
  UNDER_MAINTENANCE
  DECOMMISSIONED
}

enum FaultType {
  NO_POWER
  FLICKERING
  DAMAGED_FIXTURE
  VANDALISM
  OTHER
}

enum ReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  DELETED
}

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  userEmail  String
  userName   String
  role       String
  action     String
  entityType String
  entityId   String?
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

enum WorkOrderStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CANCELLED
}
